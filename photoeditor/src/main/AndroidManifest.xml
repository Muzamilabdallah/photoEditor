<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only needed for SaveDestination.Gallery on API 24–28, where the public
         Pictures directory is written directly (no MediaStore RELATIVE_PATH).
         Ignored on 29+. The photo picker itself needs no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
